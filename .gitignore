# raw + intermediate data; see the table in README.md for where each input comes from
/data/*
# ...except the CAGI5 reference sequences: 19 KB, required by every CAGI5 eval script,
# regenerable only via a UCSC round-trip (scripts/fetch_cagi5_references.py)
!/data/cagi5_references.json
# only the processed HDF5 payload -- disentangle/data/*.py is loader source, keep it tracked
disentangle/data/processed/

# model weights
*.pt
*.pth
*.ckpt
*.safetensors

# per-run fold dumps, regenerated by prepare_fold_data()
results/**/train.txt
results/**/val.txt
results/**/test.txt

# per-batch loss traces, superseded by val_metrics.json
all_losses.json

# logs
*.log
logs/
tensorboard/
runs/
wandb/

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# jupyter
.ipynb_checkpoints/

# node
node_modules/

# editors / os
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# local agent config
.claude/

# nested third-party repo, not part of this project
alphagenome_FT_MPRA/
